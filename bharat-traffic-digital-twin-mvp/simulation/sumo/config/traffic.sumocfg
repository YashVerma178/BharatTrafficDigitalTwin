<configuration>
  <input>
    <net-file value="../network/intersection.net.xml"/>
    <route-files value="../routes/traffic.rou.xml"/>
  </input>
  <time>
    <begin value="0"/>
    <end value="1800"/>
    <step-length value="1"/>
  </time>
  <processing>
    <time-to-teleport value="-1"/>
  </processing>
  <report>
    <verbose value="false"/>
    <no-step-log value="true"/>
  </report>
</configuration>
